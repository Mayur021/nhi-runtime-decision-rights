{
  "nhi_id": "k8s-api-service-account-v1",
  "manifest_version": "1.0.0",
  "identity_type": "service_account",
  "identity_provenance": {
    "issuer": "kubernetes.default.svc",
    "subject": "system:serviceaccount:prod:api-reader",
    "audience": "https://kubernetes.default.svc",
    "max_age_seconds": 3600,
    "trust_anchor": "k8s-cluster-ca"
  },
  "permitted_actions": [
    {
      "action": "read_logs",
      "class": "read_only",
      "target_scope": "logs.prod"
    },
    {
      "action": "list_pods",
      "class": "read_only",
      "target_scope": "k8s.pods.list"
    }
  ],
  "default_policy_when_undeclared": "refuse"
}
